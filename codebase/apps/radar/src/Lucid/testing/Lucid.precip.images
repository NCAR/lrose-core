horiz_plot_width = 800;

///////////// horiz_plot_height ///////////////////////
//
// Startup height of horizontal plot (pixels).
//
// Type: int

horiz_plot_height = 800;

///////////// horiz_window_min_width //////////////////
//
// Minimum width of main window (pixels).
//
// The user cannot shrink the main window smaller than this.
//
