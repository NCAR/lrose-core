///////////// single_segment_vsection /////////////////
//
// Option to force vertical sections to contain a single segment.
//
// If this is true, then you select a vertical section by right-clicking 
//   and dragging to draw a single-segment straight line. When you release 
//   the mouse button the resulting line defines the location of the 
//   vertical section. If this is set to false, then you can create a 
//   vertical section with multiple adjacent segments. In that case you 
//   right click and drag a series of segments, lifting the mouse button 
//   between segments and then rifht clicking again. You finalize the 
//   segment selection by double-clicking the right button close to the 
//   final point of the last segment.
//
// Type: boolean

single_segment_vsection = TRUE;

///////////// vsection_min_ht_km //////////////////////
//
// Minimum ht of cross section.
//
// This refers to the height of the data, in km, MSL.
//
// Type: double

vsection_min_ht_km = 0;

///////////// vsection_max_ht_km //////////////////////
//
// Maximum ht of cross section.
//
// This refers to the height of the data, in km, MSL.
//
// Type: double

vsection_max_ht_km = 20;

///////////// vsection_title_prefix ///////////////////
//
// Prefix for title in vertical section window.
//
// Type: string

vsection_title_prefix = "Vertical section:";

///////////// vsection_window_x_pos ///////////////////
//
// Startup X for vertical view window (pixels).
//
// This is relative to the top left corner of the screen, which is 
//   (0,0). In screen coordinates x is positive downwards. If -1 the 
//   position will be automatically determined.
//
// Type: int

vsection_window_x_pos = -1;

///////////// vsection_window_y_pos ///////////////////
//
// Startup Y for vertical view window (pixels).
//
// This is relative to the top left corner of the screen, which is 
//   (0,0). In screen coordinates y is positive to the right. If -1 the 
//   position will be automatically determined.
//
// Type: int

vsection_window_y_pos = -1;

///////////// vsection_plot_width /////////////////////
//
// Startup width of vertical plot (pixels).
//
// This is for the plot only. It does not include color scale width.
//
// Type: int

vsection_plot_width = 900;

///////////// vsection_plot_height ////////////////////
//
// Startup height of vertical plot (pixels).
//
// Type: int

vsection_plot_height = 700;

///////////// vsection_window_min_width ///////////////
//
// Minimum width of vertical window (pixels).
//
